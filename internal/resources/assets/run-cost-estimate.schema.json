{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "status",
    "scope",
    "usage_status",
    "pricing_policy",
    "pricing_policy_version",
    "pricing_policy_digest",
    "currency",
    "basis",
    "usage_revision",
    "priced_responses",
    "unpriced_responses",
    "covered_estimated_amount",
    "total_estimated_amount",
    "assumptions",
    "issues"
  ],
  "properties": {
    "schema": {
      "const": "run-cost-estimate/v1"
    },
    "run_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "estimated",
        "partial",
        "unavailable"
      ]
    },
    "scope": {
      "type": "string"
    },
    "usage_status": {
      "type": "string"
    },
    "pricing_policy": {
      "type": "string"
    },
    "pricing_policy_version": {
      "type": "string"
    },
    "pricing_policy_digest": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "basis": {
      "const": "api_equivalent"
    },
    "usage_revision": {
      "type": "integer",
      "minimum": 0
    },
    "priced_responses": {
      "type": "integer",
      "minimum": 0
    },
    "unpriced_responses": {
      "type": "integer",
      "minimum": 0
    },
    "covered_estimated_amount": {
      "type": [
        "string",
        "null"
      ]
    },
    "total_estimated_amount": {
      "type": [
        "string",
        "null"
      ]
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
