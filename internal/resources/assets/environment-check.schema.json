{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "steerrunner/environment-check/v1",
  "contract": "steerrunner-environment-check/v1",
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        },
        "base_revision": {
          "type": "string"
        },
        "remote": {
          "type": "string"
        },
        "base_branch": {
          "type": "string"
        },
        "local_path": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "base_revision",
        "remote",
        "base_branch"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "enum": [
            "codex-app-server",
            "orca-terminal"
          ]
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "local",
                "orca_environment"
              ]
            },
            "environment": {
              "type": "string"
            }
          },
          "required": [
            "kind"
          ]
        },
        "settings": {
          "type": "object"
        }
      },
      "required": [
        "adapter",
        "target",
        "settings"
      ]
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "command",
            "gitea"
          ]
        },
        "repository": {
          "type": "string"
        },
        "base_branch": {
          "type": "string"
        },
        "settings": {
          "type": "object"
        }
      },
      "required": [
        "provider",
        "repository",
        "base_branch",
        "settings"
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "correlation": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "execution": {
          "$ref": "#/$defs/execution"
        },
        "publication": {
          "$ref": "#/$defs/publication"
        },
        "execution_timeout": {
          "type": "string"
        },
        "cleanup_timeout": {
          "type": "string"
        }
      },
      "required": [
        "repository",
        "execution"
      ]
    },
    "stop_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "check_id",
        "expected_revision"
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "type": "string"
        },
        "check_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt_status": {
          "enum": [
            "accepted",
            "rejected"
          ]
        },
        "action_status": {
          "enum": [
            "pending",
            "completed",
            "failed",
            "unknown"
          ]
        }
      },
      "required": [
        "command_id",
        "check_id",
        "receipt_status",
        "action_status"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string"
        },
        "command_id": {
          "type": "string"
        },
        "command": {
          "enum": [
            "environment-check start",
            "environment-check stop"
          ]
        },
        "check_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt_status": {
          "enum": [
            "accepted",
            "rejected"
          ]
        },
        "action_status": {
          "enum": [
            "pending",
            "completed",
            "failed",
            "unknown"
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "request_id",
        "command_id",
        "command",
        "check_id",
        "receipt_status",
        "action_status",
        "error"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "turn_id": {
          "type": "string"
        },
        "nonce": {
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "tool_call_id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        },
        "facts": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "check_id",
        "session_id",
        "turn_id",
        "nonce",
        "operation_id",
        "tool_call_id",
        "source",
        "verified"
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "unverified",
            "not_applicable"
          ]
        },
        "stage": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "id",
        "required",
        "status",
        "stage",
        "evidence"
      ]
    },
    "actual": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "type": "string"
        },
        "generation": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "turn_id": {
          "type": "string"
        },
        "runtime_version": {
          "type": "string"
        },
        "process_created": {
          "type": "string"
        },
        "account": {
          "type": "string"
        },
        "authentication_source": {
          "type": "string"
        },
        "access_mode": {
          "type": "string"
        },
        "sandbox": {
          "type": "string"
        },
        "approval_policy": {
          "type": "string"
        },
        "workspace": {
          "type": "string"
        },
        "pid": {
          "type": "integer",
          "minimum": 0
        },
        "nonce": {
          "type": "string"
        },
        "native_generation": {
          "type": "string"
        }
      },
      "required": [
        "attempt_id",
        "generation",
        "access_mode"
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_ref": {
          "type": "string"
        },
        "head_ref": {
          "type": "string"
        },
        "base_sha": {
          "type": "string"
        },
        "head_sha": {
          "type": "string"
        },
        "pr_url": {
          "type": "string"
        },
        "pr_number": {
          "type": "integer",
          "minimum": 0
        },
        "pr_closed": {
          "type": "boolean"
        },
        "base_deleted": {
          "type": "boolean"
        },
        "head_deleted": {
          "type": "boolean"
        },
        "writer_stopped": {
          "type": "boolean"
        },
        "local_removed": {
          "type": "boolean"
        },
        "base_owned": {
          "type": "boolean"
        },
        "head_owned": {
          "type": "boolean"
        }
      },
      "required": [
        "base_ref",
        "head_ref",
        "base_sha",
        "pr_closed",
        "base_deleted",
        "head_deleted",
        "writer_stopped",
        "local_removed",
        "base_owned",
        "head_owned"
      ]
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "contract": {
          "const": "steerrunner-environment-check/v1"
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "resource_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input": {
          "$ref": "#/$defs/input"
        },
        "actual": {
          "$ref": "#/$defs/actual"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "execution_deadline": {
          "type": "string",
          "format": "date-time"
        },
        "cleanup_deadline": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string"
        },
        "result": {
          "enum": [
            "passed",
            "failed",
            "unverified"
          ]
        },
        "cleanup_status": {
          "enum": [
            "pending",
            "completed",
            "residual"
          ]
        },
        "diagnostic": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "allowed_actions": {
          "type": "array",
          "items": {
            "const": "stop"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "check_id",
        "revision",
        "contract",
        "input_digest",
        "resource_digest",
        "input",
        "actual",
        "created_at",
        "updated_at",
        "execution_deadline",
        "cleanup_deadline",
        "status",
        "result",
        "cleanup_status",
        "items",
        "resources",
        "allowed_actions",
        "excluded"
      ]
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "anyOf": [
            {
              "$ref": "#/$defs/command"
            },
            {
              "type": "null"
            }
          ]
        },
        "check": {
          "anyOf": [
            {
              "$ref": "#/$defs/report"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "command",
        "check"
      ]
    }
  }
}
