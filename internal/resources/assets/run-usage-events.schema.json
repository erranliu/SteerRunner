            "type": "string"
          },
          "time_basis": {
            "type": "string"
          },
          "observed_at": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "parser_version": {
            "type": "string"
          },
          "evidence_ref": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "call_time": {
            "type": [
              "string",
              "null"
            ]
          },
