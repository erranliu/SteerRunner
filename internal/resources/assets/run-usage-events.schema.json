                "minimum": 0
              },
              "input_uncached": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "cache_read": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "cache_write": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "output": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "reasoning": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
