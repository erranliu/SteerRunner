{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "steerrunner-cli/v1/service-start-input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pending_stops"
  ],
  "properties": {
    "pending_stops": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "request"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "request": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "protocol",
              "request_id",
              "input"
            ],
            "properties": {
              "protocol": {
                "const": "steerrunner-cli/v1"
              },
              "request_id": {
                "type": "string",
                "minLength": 1
              },
              "input": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "expected_revision"
                ],
                "properties": {
                  "expected_revision": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "usage_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "remote_log_access"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "remote_log_access": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "grants"
          ],
          "properties": {
            "mode": {
              "enum": [
                "disabled",
                "temporary"
              ]
            },
            "grants": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "environment",
                  "host_id",
                  "session_roots"
                ],
                "properties": {
                  "environment": {
                    "type": "string",
                    "minLength": 1
                  },
                  "host_id": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "session_roots": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "disabled"
                  }
                }
              },
              "then": {
                "properties": {
                  "grants": {
                    "maxItems": 0
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
