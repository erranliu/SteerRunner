{
  "version": 1,
  "adapters": {
    "codex-app-server": {
      "$id": "steerrunner/adapters/codex-app-server/settings/v1",
      "type": "object", "additionalProperties": false,
      "properties": {
        "executable": {"type": "string", "minLength": 1, "default": "codex.exe"},
        "model": {"type": "string", "minLength": 1},
        "reasoning_effort": {"enum": ["minimal", "low", "medium", "high", "xhigh", "max", "ultra"], "default": "medium"}
      }
    },
    "orca-terminal": {
      "$id": "steerrunner/adapters/orca-terminal/settings/v1",
      "type": "object", "additionalProperties": false,
      "properties": {
        "transport": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "executable": {"type": "string", "minLength": 1, "default": "orca.exe"},
            "args": {"type": "array", "items": {"type": "string"}},
            "wait_timeout": {"type": "string", "minLength": 1, "default": "30s", "description": "Go duration, greater than 0 and at most 1m"}
          }
        },
        "agent_launch": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "executable": {"type": "string", "minLength": 1, "default": "codex"},
            "args": {"type": "array", "items": {"type": "string"}},
            "model": {"type": "string", "minLength": 1},
            "reasoning_effort": {"enum": ["minimal", "low", "medium", "high", "xhigh", "max", "ultra"]}
          }
        }
      }
    }
  },
  "providers": {
    "command": {
      "$id": "steerrunner/providers/command/settings/v1",
      "type": "object", "additionalProperties": false, "required": ["base_url", "query"],
      "properties": {
        "base_url": {"type": "string", "format": "uri"},
        "query": {
          "type": "object", "additionalProperties": false, "required": ["executable", "args"],
          "properties": {
            "executable": {"type": "string", "minLength": 1},
            "args": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          }
        },
        "authentication_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "gitea": {
      "$id": "steerrunner/providers/gitea/settings/v1",
      "type": "object", "additionalProperties": false, "required": ["base_url"],
      "properties": {
        "base_url": {"type": "string", "format": "uri"},
        "authentication_refs": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
