{
  "version": 1,
  "workflow": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "version"
    ],
    "properties": {
      "id": {
        "enum": [
          "development",
          "development-audited"
        ]
      },
      "version": {
        "const": 2
      },
      "audit_model": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:.*\\S)?$",
            "not": {
              "pattern": "[\u0000-\u001f-]"
            }
          },
          "reasoning_effort": {
            "enum": [
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "max",
              "ultra"
            ]
          }
        }
      },
      "prompt_overrides": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "id": {
              "const": "development-audited"
            }
          }
        },
        "then": {
          "required": [
            "audit_model"
          ],
          "properties": {
            "prompt_overrides": {
              "propertyNames": {
                "enum": [
                  "implement.execute",
                  "implement.report",
                  "publish",
                  "publish.report",
                  "audit.code",
                  "audit.code.report"
                ]
              }
            }
          }
        },
        "else": {
          "not": {
            "required": [
              "audit_model"
            ]
          },
          "properties": {
            "prompt_overrides": {
              "propertyNames": {
                "enum": [
                  "implement.execute",
                  "implement.report",
                  "publish",
                  "publish.report"
                ]
              }
            }
          }
        }
      }
    ],
    "description": "Audited workflow additionally requires local codex-app-server and an explicit execution.settings.model. Omitted audit effort inherits the normalized execution effort."
  },
  "adapters": {
    "codex-app-server": {
      "$id": "steerrunner/adapters/codex-app-server/settings/v1",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1,
          "default": "codex.exe"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "not": {
            "pattern": "[\u0000\r\n]"
          }
        },
        "reasoning_effort": {
          "enum": [
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ],
          "default": "medium"
        },
        "github_auth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "app_id",
            "installation_id",
            "private_key_env"
          ],
          "properties": {
            "app_id": {
              "type": "integer",
              "minimum": 1
            },
            "installation_id": {
              "type": "integer",
              "minimum": 1
            },
            "private_key_env": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
            }
          },
          "description": "Execution-host GitHub App key reference. Runner requests one repository, contents/PR write only. Never embed a key or token."
        },
        "access_mode": {
          "enum": [
            "sandbox",
            "full_access"
          ],
          "default": "sandbox",
          "description": "Frozen explicit permission mode. Both modes use native never; no approval or fallback."
        }
      }
    },
    "orca-terminal": {
      "$id": "steerrunner/adapters/orca-terminal/settings/v1",
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "agent"
            ],
            "properties": {
              "agent": {
                "not": {
                  "enum": [
                    "codex",
                    "pi",
                    "dsh"
                  ]
                }
              }
            }
          },
          "then": {
            "properties": {
              "agent_launch": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "model"
                      ]
                    },
                    {
                      "required": [
                        "reasoning_effort"
                      ]
                    },
                    {
                      "required": [
                        "runtime_executable"
                      ]
                    },
                    {
                      "required": [
                        "runtime_sha256"
                      ]
                    }
                  ]
                },
                "properties": {
                  "args": {
                    "maxItems": 0
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "agent"
            ],
            "properties": {
              "agent": {
                "const": "pi"
              }
            }
          },
          "then": {
            "properties": {
              "agent_launch": {
                "properties": {
                  "args": {
                    "maxItems": 0
                  },
                  "reasoning_effort": {
                    "enum": [
                      "minimal",
                      "low",
                      "medium",
                      "high",
                      "xhigh"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "agent"
            ],
            "properties": {
              "agent": {
                "const": "dsh"
              }
            }
          },
          "then": {
            "properties": {
              "agent_launch": {
                "properties": {
                  "args": {
                    "maxItems": 0
                  },
                  "reasoning_effort": {
                    "enum": [
                      "low",
                      "medium",
                      "high",
                      "max"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "agent"
            ],
            "properties": {
              "agent": {
                "not": {
                  "const": "codex"
                }
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "github_auth"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "github_auth"
            ]
          },
          "then": {
            "required": [
              "agent_launch"
            ],
            "properties": {
              "agent_launch": {
                "required": [
                  "runtime_executable"
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "agent": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "default": "codex",
          "description": "Orca terminal agent identifier. Missing preserves the Codex default; runtime evidence and permission qualification are still required."
        },
        "transport": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "executable": {
              "type": "string",
              "minLength": 1,
              "default": "orca.exe"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "wait_timeout": {
              "type": "string",
              "minLength": 1,
              "default": "30s",
              "description": "Go duration, greater than 0 and at most 1m"
            }
          }
        },
        "agent_launch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runtime_executable": {
              "type": "string",
              "minLength": 1,
              "description": "Trusted steerrunner-agent executable installed on the execution host; owns host authentication and same-mode native preparation."
            },
            "runtime_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "Optional frozen SHA256 of the execution-host helper; required in qualification configs."
            },
            "executable": {
              "type": "string",
              "minLength": 1,
              "description": "Native executable; defaults to codex, pi.cmd or dsh.cmd for the corresponding managed agent."
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "reasoning_effort": {
              "enum": [
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max",
                "ultra"
              ]
            }
          }
        },
        "access_mode": {
          "enum": [
            "sandbox",
            "full_access"
          ],
          "default": "sandbox",
          "description": "Frozen explicit permission mode. Both modes use native never; no approval or fallback."
        },
        "github_auth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "app_id",
            "installation_id",
            "private_key_env"
          ],
          "properties": {
            "app_id": {
              "type": "integer",
              "minimum": 1
            },
            "installation_id": {
              "type": "integer",
              "minimum": 1
            },
            "private_key_env": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
            }
          },
          "description": "Execution-host GitHub App key reference. Runner requests one repository, contents/PR write only. Never embed a key or token."
        }
      }
    }
  },
  "providers": {
    "command": {
      "$id": "steerrunner/providers/command/settings/v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_url",
        "query"
      ],
      "properties": {
        "base_url": {
          "type": "string",
          "format": "uri"
        },
        "query": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executable",
            "args"
          ],
          "properties": {
            "executable": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "authentication_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "gitea": {
      "$id": "steerrunner/providers/gitea/settings/v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_url"
      ],
      "properties": {
        "base_url": {
          "type": "string",
          "format": "uri"
        },
        "authentication_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
