{
  "contract": "steerrunner-environment-check/v1",
  "input_schema": "steerrunner/environment-check/v1#/$defs/input",
  "report_schema": "steerrunner/environment-check/v1#/$defs/report",
  "reference_namespace": "steerline-check/<check_id>/{base,head}",
  "operations": [
    "permissions",
    "workspace",
    "temporary",
    "git_admin",
    "remote_read",
    "fetch",
    "base_push",
    "commit",
    "head_push",
    "pr_create",
    "pr_query",
    "pr_close"
  ],
  "targets": [
    {
      "adapter": "codex-app-server",
      "target": "local",
      "platform": "windows",
      "access_modes": [
        "sandbox",
        "full_access"
      ],
      "mechanism": "implemented",
      "authentication_sources": [
        "host-gh-repository-broker"
      ],
      "native_version": "codex-cli 0.159.2"
    },
    {
      "adapter": "orca-terminal",
      "target": "orca_environment",
      "access_modes": [
        "sandbox",
        "full_access"
      ],
      "mechanism": "unsupported",
      "authentication_sources": [],
      "reason": "Remote Orca native Runs use existing host authentication; full permission/broker checks require a local managed target."
    },
    {
      "adapter": "orca-terminal",
      "target": "local",
      "access_modes": [
        "sandbox",
        "full_access"
      ],
      "mechanism": "implemented",
      "authentication_sources": [
        "host-gh-repository-broker"
      ],
      "native_version": "codex-cli 0.159.2",
      "required_runtime": "agent_launch.runtime_executable (steerrunner-agent on execution host)"
    }
  ],
  "publication": {
    "provider": "command",
    "base_url": "https://github.com",
    "required_when_present": true
  },
  "excludes": [
    "build",
    "tests",
    "business_resources"
  ],
  "policy_contract": "codex-policy-v10:0.159.2:explicit-access-mode:repository-auth-broker:never",
  "unsupported_authentication_sources": [
    "github-app-authentication: unsupported; use execution-host gh login"
  ]
}
