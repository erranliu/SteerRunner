{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "steerrunner/test-config/v1",
  "description": "Test-only outer structure. Configuration entries and fixture contents are validated separately so invalid entries disable only dependent cases. Execution and workflow use the selected Runner production contracts.",
  "type": "object",
  "required": [
    "schema"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "steerrunner-test-config/v1"
    },
    "configurations": {
      "type": "object",
      "additionalProperties": true
    },
    "fixture": {
      "type": "object",
      "additionalProperties": true
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "admin_host": {
          "type": "string"
        }
      }
    }
  }
}
