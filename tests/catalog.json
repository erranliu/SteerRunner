{
  "schema": "steerrunner-tests/v1",
  "l1_packages": [
    "./internal/..."
  ],
  "controlled_scenarios": [
    "TestSRStandalonePackage",
    "TestSRServiceOwnership",
    "TestSRInputFreeze",
    "TestSRPermissionQualification",
    "TestSRRunWorkflow",
    "TestSRStorageLogsEvents",
    "TestSRPublicationIdentity",
    "TestSRPublicationBeforeWorkflowReady",
    "TestSRNativeUnknownAndStop",
    "TestSRRestartPreservesAuthorization",
    "TestSRStabilityLostSubmitResponse",
    "TestSRStabilityRevocationAcrossRestart",
    "TestSRWorkflowDiscoveryAndSelection",
    "TestSRMultipleRunsIsolation",
    "TestSRResultAcquisition",
    "TestSRContentGenerate",
    "TestSRContentRepository",
    "TestSRContentConversation",
    "TestSRContentQuestionAndUnknown",
    "TestSRContentGenerationRecovery",
    "TestSRRunEvidenceR2",
    "TestSRResourceCreationRecovery",
    "TestSRProgressFile",
    "TestSRResultFile",
    "TestSROrcaCLIWaitRetry"
  ],
  "scenarios": [
    "orca-local.codex",
    "orca-local.pi",
    "orca-local.dsh",
    "local-codex.result-acquisition",
    "local-codex.smoke",
    "orca-remote.smoke",
    "orca-remote.caller-exit",
    "orca-remote.connection-reconnect",
    "orca-remote.service-restart",
    "orca-remote.stop-revocation",
    "orca-remote.publication-unknown",
    "local-codex.audited",
    "local-codex.multirun",
    "controlled.permanent-evidence-loss",
    "controlled.stop-commit-race",
    "controlled.storage-failure",
    "controlled.resource-pressure",
    "orca-remote.multirun",
    "orca-local.smoke",
    "orca-local.mixed",
    "orca-remote.initialization-stop",
    "local-codex.progress-file",
    "orca-local.progress-file",
    "orca-remote.progress-file",
    "local-codex.progress-multirun",
    "local-codex.progress-recovery",
    "orca-local.cli-wait-retry",
    "orca-remote.cli-wait-retry"
  ],
  "focused_native_scenarios": [
    {
      "id": "orca-remote.native-input",
      "level": "L3",
      "test": "TestOrcaNativeStateLiveLifecycle",
      "entry": "scripts/test-native-input.ps1",
      "scope": "fresh empty Orca worktree; fixed CLI/native launch; synthetic no-tools input; no business suite or PR",
      "requires": [
        "explicit fixed target.json",
        "new output directory",
        "complete empty terminal census"
      ],
      "expected": [
        "unique complete original input and canonical result",
        "one production paste and Enter",
        "unknown effects never replayed in controlled regressions",
        "confirmed terminal close and zero complete census"
      ],
      "subcases": [
        {
          "id": "long-input",
          "mode": "long-input",
          "scope": "production Lifecycle; natural draft shape recorded"
        },
        {
          "id": "segmented-shape",
          "mode": "segmented-shape",
          "scope": "two explicit real paste effects; one logical input and Enter; separate shape qualification"
        }
      ]
    },
    {
      "id": "local-codex.generate-repository",
      "level": "L3",
      "test": "TestSRContentRepositoryNative",
      "entry": "scripts/test-foundation.ps1",
      "scope": "new C:/srt/gr-* state and disposable dirty Git fixture; read-only native code investigation; no target writes or PR",
      "requires": [
        "explicit native executable",
        "TestSRContentRepository"
      ],
      "expected": [
        "real read-only code tool observed",
        "fixed commit and full two-document result",
        "original request replay and completed-result restart",
        "stop and verify-stopped settlement"
      ]
    },
    {
      "id": "local-codex.generation-recovery",
      "level": "L3",
      "test": "TestSRContentNativeGenerationRecovery",
      "entry": "scripts/test-generation-recovery.ps1",
      "scope": "new C:/srt/cw-recovery-* state; real native Codex, no Git or PR",
      "requires": [
        "explicit native executable",
        "controlled recovery prerequisites"
      ],
      "expected": [
        "active graceful restart",
        "active kill",
        "compatible binary takeover",
        "startup stop",
        "same original process/session/turn",
        "offline resource settlement"
      ]
    },
    {
      "id": "local-codex.parser-generation-recovery",
      "level": "L3",
      "test": "TestSRNativeParserGenerationRecovery",
      "entry": "scripts/test-generation-recovery.ps1",
      "scope": "isolated controlled business/provider; real native parser and original owner; no real PR",
      "requires": [
        "explicit native executable",
        "controlled recovery prerequisites"
      ],
      "expected": [
        "original parser survives graceful/kill",
        "offline completion adopted once",
        "explicit stop cancels original parser"
      ]
    },
    {
      "id": "local-codex.content-workflows",
      "level": "L3",
      "test": "TestSRContentNative",
      "entry": "scripts/test-content-workflows.ps1",
      "scope": "new C:/srt/gt-* and cw-* states, original native Codex 0.159.2, no Git or PR",
      "requires": [
        "explicit native executable",
        "controlled content prerequisites"
      ],
      "expected": [
        "one structured generation",
        "same-thread multiple turns",
        "interrupt then continue",
        "idle service restart then original-thread continue",
        "resource settlement",
        "explicit generated Run stop",
        "offline resource settlement",
        "same EXE takeover retains Run/input/request bindings",
        "unchanged original database"
      ],
      "subcases": [
        {
          "id": "generate-takeover",
          "pattern": "^TestSRContentNative$/^generate-takeover$"
        },
        {
          "id": "conversation",
          "pattern": "^TestSRContentNative$/^conversation$"
        }
      ]
    }
  ]
}
