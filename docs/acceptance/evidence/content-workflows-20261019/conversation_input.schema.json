                      },
                      "type": "array"
                    },
                    "executable": {
                      "default": "orca.exe",
                      "minLength": 1,
                      "type": "string"
                    },
                    "wait_timeout": {
                      "default": "30s",
                      "description": "Go duration, greater than 0 and at most 1m",
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            },
            "target": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "environment": {
                      "const": ""
                    },
                    "kind": {
                      "const": "local"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
