{
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "workflow": {
            "properties": {
              "id": {
                "const": "development"
              },
              "version": {
                "const": 2
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "adapter": {
                "enum": [
                  "codex-app-server",
                  "orca-terminal"
                ]
              },
              "settings": {
                "allOf": [
                  {},
                  {
                    "properties": {
                      "access_mode": {
                        "enum": [
                          "",
                          "sandbox",
                          "full_access"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          },
          "workflow": {
            "properties": {
              "prompt_overrides": {
                "propertyNames": {
                  "enum": [
                    "implement.execute",
                    "implement.report",
                    "publish",
                    "publish.report"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workflow": {
            "properties": {
              "id": {
                "const": "development-audited"
              },
              "version": {
                "const": 2
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "allOf": [
              {
                "if": {
                  "properties": {
                    "adapter": {
                      "const": "codex-app-server"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "settings": {
                      "properties": {
                        "model": {
                          "minLength": 1,
                          "not": {
                            "pattern": "[\u0000-\u001f-]"
                          },
                          "pattern": "^\\S(?:.*\\S)?$",
                          "type": "string"
                        }
                      },
                      "required": [
                        "model"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "adapter": {
                      "const": "orca-terminal"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "settings": {
                      "properties": {
                        "agent": {
                          "const": "codex"
                        },
                        "agent_launch": {
                          "properties": {
                            "model": {
                              "minLength": 1,
                              "not": {
                                "pattern": "[\u0000-\u001f-]"
                              },
                              "pattern": "^\\S(?:.*\\S)?$",
                              "type": "string"
                            },
                            "runtime_executable": {
                              "minLength": 1,
                              "type": "string"
                            }
                          },
                          "required": [
                            "model",
                            "runtime_executable"
                          ]
                        }
                      },
                      "required": [
                        "agent_launch"
                      ]
                    },
                    "target": {
                      "additionalProperties": false,
                      "properties": {
                        "environment": {
                          "const": ""
                        },
                        "kind": {
                          "const": "local"
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "type": "object"
                    }
                  }
                }
              }
            ],
            "properties": {
              "adapter": {
                "enum": [
                  "codex-app-server",
                  "orca-terminal"
                ]
              },
              "settings": {
                "allOf": [
                  {},
                  {
                    "properties": {
                      "access_mode": {
                        "enum": [
                          "",
                          "sandbox",
                          "full_access"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          },
          "workflow": {
            "properties": {
              "prompt_overrides": {
                "propertyNames": {
                  "enum": [
                    "implement.execute",
                    "implement.report",
                    "publish",
                    "publish.report",
                    "audit.code",
                    "audit.code.report"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workflow": {
            "properties": {
              "id": {
                "const": "conversation"
              },
              "version": {
                "const": 1
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "adapter": {
                "enum": [
                  "codex-app-server"
                ]
              },
              "settings": {
                "properties": {
                  "access_mode": {
                    "const": "read_only"
                  }
                },
                "required": [
                  "access_mode"
                ]
              }
            }
          },
          "workflow": {
            "properties": {
              "prompt_overrides": false
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workflow": {
            "properties": {
              "id": {
                "const": "generate"
              },
              "version": {
                "const": 1
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "adapter": {
                "enum": [
                  "codex-app-server"
                ]
              },
              "settings": {
                "properties": {
                  "access_mode": {
                    "const": "read_only"
                  }
                },
                "required": [
                  "access_mode"
                ]
              }
            }
          },
          "workflow": {
            "properties": {
              "prompt_overrides": false
            }
          }
        }
      }
    }
  ],
  "properties": {
    "execution": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "adapter": {
              "const": "codex-app-server"
            },
            "settings": {
              "$id": "steerrunner/adapters/codex-app-server/settings/v1",
              "additionalProperties": false,
              "properties": {
                "access_mode": {
                  "default": "sandbox",
                  "description": "Frozen explicit permission mode. Both modes use native never; no approval or fallback.",
                  "enum": [
                    "",
                    "sandbox",
                    "full_access",
                    "read_only"
                  ]
                },
                "executable": {
                  "default": "codex.exe",
                  "minLength": 1,
                  "type": "string"
                },
                "model": {
                  "minLength": 1,
                  "not": {
                    "pattern": "[\u0000\r\n]"
                  },
                  "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
                  "type": "string"
                },
                "reasoning_effort": {
                  "default": "medium",
                  "enum": [
                    "minimal",
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max",
                    "ultra"
                  ]
                }
              },
              "type": "object"
            },
            "target": {
              "additionalProperties": false,
              "properties": {
                "environment": {
                  "const": ""
                },
                "kind": {
                  "const": "local"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            }
          },
          "required": [
            "adapter",
            "target",
            "settings"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "target": {
                    "additionalProperties": false,
                    "properties": {
                      "environment": {
                        "minLength": 1,
                        "pattern": "\\S",
                        "type": "string"
                      },
                      "kind": {
                        "const": "orca_environment"
                      }
                    },
                    "required": [
                      "kind",
                      "environment"
                    ],
                    "type": "object"
                  }
                }
              },
              "then": {
                "properties": {
                  "settings": {
                    "properties": {
                      "agent_launch": {
                        "not": {
                          "anyOf": [
                            {
                              "required": [
                                "runtime_executable"
                              ]
                            },
                            {
                              "required": [
                                "runtime_sha256"
                              ]
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          ],
          "properties": {
            "adapter": {
              "const": "orca-terminal"
            },
            "settings": {
              "$id": "steerrunner/adapters/orca-terminal/settings/v1",
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "agent": {
                        "not": {
                          "enum": [
                            "codex",
                            "pi",
                            "dsh"
                          ]
                        }
                      }
                    },
                    "required": [
                      "agent"
                    ]
                  },
                  "then": {
                    "properties": {
                      "agent_launch": {
                        "not": {
                          "anyOf": [
                            {
                              "required": [
                                "model"
                              ]
                            },
                            {
                              "required": [
                                "reasoning_effort"
                              ]
                            },
                            {
                              "required": [
                                "runtime_executable"
                              ]
                            },
                            {
                              "required": [
                                "runtime_sha256"
                              ]
                            }
                          ]
                        },
                        "properties": {
                          "args": {
                            "maxItems": 0
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "agent": {
                        "const": "pi"
                      }
                    },
                    "required": [
                      "agent"
                    ]
                  },
                  "then": {
                    "properties": {
                      "agent_launch": {
                        "properties": {
                          "args": {
                            "maxItems": 0
                          },
                          "reasoning_effort": {
                            "enum": [
                              "minimal",
                              "low",
                              "medium",
                              "high",
                              "xhigh"
                            ]
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "agent": {
                        "const": "dsh"
                      }
                    },
                    "required": [
                      "agent"
                    ]
                  },
                  "then": {
                    "properties": {
                      "agent_launch": {
                        "properties": {
                          "args": {
                            "maxItems": 0
                          },
                          "reasoning_effort": {
                            "enum": [
                              "low",
                              "medium",
                              "high",
                              "max"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              ],
              "properties": {
                "access_mode": {
                  "default": "sandbox",
                  "description": "Frozen explicit permission mode. Both modes use native never; no approval or fallback.",
                  "enum": [
                    "",
                    "sandbox",
                    "full_access"
                  ]
                },
                "agent": {
                  "default": "codex",
                  "description": "Orca terminal agent identifier. Missing preserves the Codex default; runtime evidence and permission qualification are still required.",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
                  "type": "string"
                },
                "agent_launch": {
                  "additionalProperties": false,
                  "properties": {
                    "args": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "executable": {
                      "description": "Native executable; defaults to codex, pi.cmd or dsh.cmd for the corresponding managed agent.",
                      "minLength": 1,
                      "type": "string"
                    },
                    "model": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "reasoning_effort": {
                      "enum": [
                        "minimal",
                        "low",
                        "medium",
                        "high",
                        "xhigh",
                        "max",
                        "ultra"
                      ]
                    },
                    "runtime_executable": {
                      "description": "Local target only: trusted managed terminal helper. Forbidden for orca_environment, including empty values.",
                      "minLength": 1,
                      "type": "string"
                    },
                    "runtime_sha256": {
                      "description": "Local target only: frozen helper SHA256. Forbidden for orca_environment.",
                      "pattern": "^[a-f0-9]{64}$",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "transport": {
                  "additionalProperties": false,
                  "properties": {
                    "args": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "executable": {
                      "default": "orca.exe",
                      "minLength": 1,
                      "type": "string"
                    },
                    "wait_timeout": {
                      "default": "30s",
                      "description": "Go duration, greater than 0 and at most 1m",
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            },
            "target": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "environment": {
                      "const": ""
                    },
                    "kind": {
                      "const": "local"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "environment": {
                      "minLength": 1,
                      "pattern": "\\S",
                      "type": "string"
                    },
                    "kind": {
                      "const": "orca_environment"
                    }
                  },
                  "required": [
                    "kind",
                    "environment"
                  ],
                  "type": "object"
                }
              ]
            }
          },
          "required": [
            "adapter",
            "target",
            "settings"
          ],
          "type": "object"
        }
      ]
    },
    "workflow": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "not": {
              "required": [
                "audit_model"
              ]
            },
            "properties": {
              "prompt_overrides": {
                "propertyNames": {
                  "enum": [
                    "implement.execute",
                    "implement.report",
                    "publish",
                    "publish.report"
                  ]
                }
              }
            }
          },
          "if": {
            "properties": {
              "id": {
                "const": "development-audited"
              }
            }
          },
          "then": {
            "properties": {
              "prompt_overrides": {
                "propertyNames": {
                  "enum": [
                    "implement.execute",
                    "implement.report",
                    "publish",
                    "publish.report",
                    "audit.code",
                    "audit.code.report"
                  ]
                }
              }
            },
            "required": [
              "audit_model"
            ]
          }
        },
        {
          "else": {
            "properties": {
              "version": {
                "const": 2
              }
            }
          },
          "if": {
            "properties": {
              "id": {
                "enum": [
                  "conversation",
                  "generate"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "prompt_overrides": {
                "maxProperties": 0
              },
              "version": {
                "const": 1
              }
            }
          }
        }
      ],
      "description": "Audited workflow requires managed Codex with two explicit, different models. Orca uses execution.settings.agent_launch.model and the trusted execution-host runtime. Omitted audit effort inherits the normalized execution effort.",
      "properties": {
        "audit_model": {
          "additionalProperties": false,
          "properties": {
            "model": {
              "minLength": 1,
              "not": {
                "pattern": "[\u0000-\u001f-]"
              },
              "pattern": "^\\S(?:.*\\S)?$",
              "type": "string"
            },
            "reasoning_effort": {
              "enum": [
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max",
                "ultra"
              ]
            }
          },
          "required": [
            "model"
          ],
          "type": "object"
        },
        "id": {
          "enum": [
            "development",
            "development-audited",
            "conversation",
            "generate"
          ]
        },
        "prompt_overrides": {
          "additionalProperties": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "type": "object"
        },
        "version": {
          "enum": [
            1,
            2
          ]
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    }
  },
  "required": [
    "execution",
    "workflow"
  ],
  "type": "object"
}
